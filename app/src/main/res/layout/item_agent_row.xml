<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_xs">

    <View
        android:id="@+id/agent_status_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="@drawable/arc_reactor_core" />

    <TextView
        android:id="@+id/txt_agent_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/jarvis_text_primary"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/txt_agent_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/jarvis_text_secondary"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
