<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <!-- User message (right-aligned) -->
    <LinearLayout
        android:id="@+id/layout_user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:visibility="gone"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_user_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="64dp"
            android:background="@drawable/bg_chat_bubble_user"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/jarvis_window_background"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txt_user_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:textColor="@color/jarvis_text_hint"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- JARVIS message (left-aligned) -->
    <LinearLayout
        android:id="@+id/layout_jarvis_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:visibility="gone"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/arc_reactor_core" />

            <TextView
                android:id="@+id/txt_agent_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="JARVIS"
                android:textColor="@color/jarvis_accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_jarvis_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="64dp"
            android:background="@drawable/bg_chat_bubble_jarvis"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txt_jarvis_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp"
            android:textColor="@color/jarvis_text_hint"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
