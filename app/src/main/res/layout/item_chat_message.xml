<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacing_sm">

    <!-- User message (right-aligned) -->
    <LinearLayout
        android:id="@+id/layout_user_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_user_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xxl"
            android:background="@drawable/bg_chat_bubble_user"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:textColor="@color/jarvis_window_background"
            android:textSize="@dimen/text_chat" />
    </LinearLayout>

    <!-- JARVIS message (left-aligned) -->
    <LinearLayout
        android:id="@+id/layout_jarvis_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:visibility="gone"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_xs">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/arc_reactor_core" />

            <TextView
                android:id="@+id/txt_agent_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:text="JARVIS"
                android:textColor="@color/jarvis_accent"
                android:textSize="@dimen/text_caption"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_jarvis_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_xxl"
            android:background="@drawable/bg_chat_bubble_jarvis"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:textColor="@color/jarvis_text_primary"
            android:textSize="@dimen/text_chat" />
    </LinearLayout>
</LinearLayout>