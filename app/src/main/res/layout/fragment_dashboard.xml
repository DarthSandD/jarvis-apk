<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_window_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Greeting header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_home_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good evening"
                    android:textColor="@color/jarvis_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JARVIS"
                    android:textColor="@color/jarvis_text_primary"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_home_status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="● ONLINE"
                android:textColor="@color/jarvis_online"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Hero orb card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_modern"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="180dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_orb" />

                <com.darrenai.jarvis.ui.face.ArcReactorView
                    android:id="@+id/home_orb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_home_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ready when you are"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home_talk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tap to talk"
                android:textColor="@color/jarvis_window_background"
                android:textSize="13sp"
                app:backgroundTint="@color/jarvis_accent"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_mic"
                app:iconTint="@color/jarvis_window_background"
                app:iconSize="16dp" />
        </LinearLayout>

        <!-- Quick actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUICK ACTIONS"
            android:textColor="@color/jarvis_text_hint"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home_chat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Chat"
                android:textColor="@color/jarvis_accent"
                android:textSize="12sp"
                app:backgroundTint="@color/jarvis_chip_background"
                app:strokeColor="@color/jarvis_accent_dim"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_chat"
                app:iconTint="@color/jarvis_accent"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home_face"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Face"
                android:textColor="@color/jarvis_violet"
                android:textSize="12sp"
                app:backgroundTint="@color/jarvis_chip_background"
                app:strokeColor="@color/jarvis_violet"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_face"
                app:iconTint="@color/jarvis_violet"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home_briefing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Brief"
                android:textColor="@color/jarvis_gold"
                android:textSize="12sp"
                app:backgroundTint="@color/jarvis_chip_background"
                app:strokeColor="@color/jarvis_gold_dim"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_schedule"
                app:iconTint="@color/jarvis_gold"
                app:iconSize="16dp" />
        </LinearLayout>

        <!-- Connection card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_modern"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTION"
                android:textColor="@color/jarvis_text_hint"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_home_endpoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10.212.104.124:20128"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/txt_home_latency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Checking…"
                android:textColor="@color/jarvis_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
