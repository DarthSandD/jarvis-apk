<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_window_background">

    <!-- Status text -->
    <TextView
        android:id="@+id/txt_voice_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:text="@string/voice_tap_to_speak"
        android:textColor="@color/jarvis_text_secondary"
        android:textSize="@dimen/text_body"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Arc Reactor Voice Button -->
    <FrameLayout
        android:id="@+id/voice_reactor_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/txt_voice_status"
        app:layout_constraintBottom_toTopOf="@id/scroll_transcript"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/spacing_xxl"
        android:layout_marginBottom="@dimen/spacing_xxl">

        <!-- Outer glow ring -->
        <View
            android:id="@+id/voice_ring_outer"
            android:layout_width="@dimen/voice_reactor_outer"
            android:layout_height="@dimen/voice_reactor_outer"
            android:layout_gravity="center"
            android:background="@drawable/arc_reactor_bg"
            android:alpha="0.3" />

        <!-- Middle ring -->
        <View
            android:id="@+id/voice_ring_middle"
            android:layout_width="@dimen/voice_reactor_middle"
            android:layout_height="@dimen/voice_reactor_middle"
            android:layout_gravity="center"
            android:background="@drawable/arc_reactor_bg"
            android:alpha="0.5" />

        <!-- Inner button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_voice"
            android:layout_width="@dimen/voice_reactor_inner"
            android:layout_height="@dimen/voice_reactor_inner"
            android:layout_gravity="center"
            android:contentDescription="@string/voice_tap_to_speak"
            android:src="@drawable/ic_mic"
            app:backgroundTint="@color/jarvis_accent"
            app:tint="@color/jarvis_window_background"
            app:elevation="0dp"
            app:borderWidth="0dp" />
    </FrameLayout>

    <!-- Waveform bars (visible when listening) -->
    <LinearLayout
        android:id="@+id/layout_voice_waveform"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginHorizontal="@dimen/spacing_xxl"
        app:layout_constraintTop_toTopOf="@id/voice_reactor_container"
        app:layout_constraintBottom_toBottomOf="@id/voice_reactor_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View android:id="@+id/wave_bar_1" android:layout_width="3dp" android:layout_height="20dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_2" android:layout_width="3dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_3" android:layout_width="3dp" android:layout_height="55dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_4" android:layout_width="3dp" android:layout_height="30dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_5" android:layout_width="3dp" android:layout_height="50dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_6" android:layout_width="3dp" android:layout_height="35dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_7" android:layout_width="3dp" android:layout_height="45dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_8" android:layout_width="3dp" android:layout_height="25dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_9" android:layout_width="3dp" android:layout_height="55dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_10" android:layout_width="3dp" android:layout_height="40dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_11" android:layout_width="3dp" android:layout_height="20dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
        <View android:id="@+id/wave_bar_12" android:layout_width="3dp" android:layout_height="50dp" android:layout_marginHorizontal="2dp" android:background="@drawable/arc_reactor_core" />
    </LinearLayout>

    <!-- Transcript -->
    <ScrollView
        android:id="@+id/scroll_transcript"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/voice_reactor_container"
        app:layout_constraintBottom_toTopOf="@id/layout_voice_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- User transcript -->
            <TextView
                android:id="@+id/txt_user_transcript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:visibility="gone"
                android:background="@drawable/bg_chat_bubble_user"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_sm"
                android:textColor="@color/jarvis_window_background"
                android:textSize="@dimen/text_chat" />

            <!-- JARVIS response -->
            <TextView
                android:id="@+id/txt_jarvis_response"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:visibility="gone"
                android:background="@drawable/bg_chat_bubble_jarvis"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_sm"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="@dimen/text_chat" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom action buttons -->
    <LinearLayout
        android:id="@+id/layout_voice_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="@dimen/spacing_xxl"
        android:layout_marginBottom="@dimen/spacing_xxl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_voice_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_md"
            android:text="@string/voice_history"
            android:textColor="@color/jarvis_text_secondary"
            android:textSize="@dimen/text_caption"
            app:backgroundTint="@color/jarvis_chip_background"
            app:strokeColor="@color/jarvis_divider"
            app:strokeWidth="1dp"
            app:cornerRadius="@dimen/corner_pill"
            app:icon="@drawable/ic_library"
            app:iconTint="@color/jarvis_text_secondary"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_voice_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_settings"
            android:textColor="@color/jarvis_text_secondary"
            android:textSize="@dimen/text_caption"
            app:backgroundTint="@color/jarvis_chip_background"
            app:strokeColor="@color/jarvis_divider"
            app:strokeWidth="1dp"
            app:cornerRadius="@dimen/corner_pill"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/jarvis_text_secondary"
            app:iconSize="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
