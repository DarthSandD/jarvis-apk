<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_window_background">

    <!-- Status text -->
    <TextView
        android:id="@+id/txt_voice_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/voice_tap_to_speak"
        android:textColor="@color/jarvis_text_secondary"
        android:textSize="15sp"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Orb + mic -->
    <FrameLayout
        android:id="@+id/voice_reactor_container"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/txt_voice_status"
        app:layout_constraintBottom_toTopOf="@id/scroll_transcript"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_orb" />

        <com.darrenai.jarvis.ui.face.ArcReactorView
            android:id="@+id/voice_orb"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_voice"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:contentDescription="@string/voice_tap_to_speak"
            android:src="@drawable/ic_mic"
            app:backgroundTint="@color/jarvis_accent"
            app:tint="@color/jarvis_window_background"
            app:elevation="6dp"
            app:borderWidth="0dp" />
    </FrameLayout>

    <!-- Transcript -->
    <ScrollView
        android:id="@+id/scroll_transcript"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/voice_reactor_container"
        app:layout_constraintBottom_toTopOf="@id/layout_voice_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_user_transcript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:background="@drawable/bg_chat_bubble_user"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/jarvis_window_background"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txt_jarvis_response"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:background="@drawable/bg_card_modern"
                android:padding="16dp"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom action buttons -->
    <LinearLayout
        android:id="@+id/layout_voice_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_voice_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/voice_history"
            android:textColor="@color/jarvis_text_secondary"
            android:textSize="12sp"
            app:backgroundTint="@color/jarvis_chip_background"
            app:strokeColor="@color/jarvis_divider"
            app:strokeWidth="1dp"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_library"
            app:iconTint="@color/jarvis_text_secondary"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_voice_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_settings"
            android:textColor="@color/jarvis_text_secondary"
            android:textSize="12sp"
            app:backgroundTint="@color/jarvis_chip_background"
            app:strokeColor="@color/jarvis_divider"
            app:strokeWidth="1dp"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/jarvis_text_secondary"
            app:iconSize="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
