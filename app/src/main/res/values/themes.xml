<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        JARVIS Theme — Iron Man Arc Reactor Edition 2.0
        Material 3 / Edge-to-Edge / Glass Morphism
    -->

    <!-- Base theme -->
    <style name="Theme.JARVIS" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/jarvis_accent</item>
        <item name="colorOnPrimary">@color/jarvis_window_background</item>
        <item name="colorPrimaryContainer">@color/jarvis_surface_elevated</item>
        <item name="colorOnPrimaryContainer">@color/jarvis_text_primary</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/jarvis_accent_secondary</item>
        <item name="colorOnSecondary">@color/jarvis_window_background</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_text_primary</item>
        <item name="colorSurfaceVariant">@color/jarvis_surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/jarvis_text_secondary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/jarvis_window_background</item>
        <item name="colorOnBackground">@color/jarvis_text_primary</item>

        <!-- Error -->
        <item name="colorError">@color/jarvis_accent_danger</item>
        <item name="colorOnError">@color/jarvis_white</item>

        <!-- Status bar / Navigation -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/jarvis_window_background</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.JARVIS.Display</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.JARVIS.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.JARVIS.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.JARVIS.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.JARVIS.Label</item>
    </style>

    <!-- Text appearances -->
    <style name="TextAppearance.JARVIS.Display" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/jarvis_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.JARVIS.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/jarvis_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.JARVIS.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/jarvis_text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.JARVIS.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/jarvis_text_primary</item>
    </style>

    <style name="TextAppearance.JARVIS.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/jarvis_text_secondary</item>
    </style>

    <!-- App title (top bar) -->
    <style name="JARVIS.AppTitle" parent="">
        <item name="android:textColor">@color/jarvis_accent</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Chat bubble: user -->
    <style name="JARVIS.ChatBubble.User" parent="">
        <item name="android:background">@drawable/bg_chat_user</item>
        <item name="android:paddingTop">@dimen/chat_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/chat_padding_vertical</item>
        <item name="android:paddingStart">@dimen/chat_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/chat_padding_horizontal</item>
        <item name="android:maxWidth">@dimen/chat_bubble_max</item>
    </style>

    <!-- Chat bubble: assistant -->
    <style name="JARVIS.ChatBubble.Assistant" parent="">
        <item name="android:background">@drawable/bg_chat_assistant</item>
        <item name="android:paddingTop">@dimen/chat_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/chat_padding_vertical</item>
        <item name="android:paddingStart">@dimen/chat_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/chat_padding_horizontal</item>
        <item name="android:maxWidth">@dimen/chat_bubble_max</item>
    </style>

    <!-- Chat bubble: system -->
    <style name="JARVIS.ChatBubble.System" parent="">
        <item name="android:background">@drawable/bg_chat_assistant</item>
        <item name="android:paddingTop">@dimen/chat_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/chat_padding_vertical</item>
        <item name="android:paddingStart">@dimen/chat_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/chat_padding_horizontal</item>
        <item name="android:maxWidth">@dimen/chat_bubble_max</item>
    </style>

    <!-- Send button (pill shape, accent) -->
    <style name="JARVIS.Button.Send" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/jarvis_accent</item>
        <item name="android:textColor">@color/jarvis_window_background</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="iconTint">@color/jarvis_window_background</item>
        <item name="android:minHeight">@dimen/btn_height_md</item>
        <item name="android:minWidth">@dimen/btn_height_md</item>
    </style>

    <!-- Mic button (pill, toggles active state) -->
    <style name="JARVIS.Button.Mic" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/jarvis_voice_inactive</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_pill</item>
        <item name="iconTint">@color/jarvis_icon_tint</item>
        <item name="android:minHeight">@dimen/btn_height_md</item>
        <item name="android:minWidth">@dimen/btn_height_md</item>
    </style>

    <!-- Settings button (icon only, ghost) -->
    <style name="JARVIS.Button.Settings" parent="Widget.Material3.Button.TextButton">
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="iconTint">@color/jarvis_icon_tint</item>
        <item name="android:minHeight">@dimen/btn_height_md</item>
        <item name="android:minWidth">@dimen/btn_height_md</item>
    </style>

    <!-- Input field -->
    <style name="JARVIS.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:textColor">@color/jarvis_text_primary</item>
        <item name="android:textColorHint">@color/jarvis_text_hint</item>
        <item name="android:textSize">@dimen/text_chat</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Icon button style -->
    <style name="JARVIS.IconButton" parent="">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Card style -->
    <style name="JARVIS.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/spacing_md</item>
    </style>
</resources>
