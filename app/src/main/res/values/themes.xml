<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- JARVIS Dark Theme -->
    <style name="Theme.JARVIS" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/jarvis_window_background</item>
        <item name="android:statusBarColor">@color/jarvis_window_background</item>
        <item name="android:navigationBarColor">@color/jarvis_nav_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/jarvis_accent</item>
        <item name="colorPrimaryVariant">@color/jarvis_accent_dim</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/jarvis_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_text_primary</item>
        <item name="android:colorBackground">@color/jarvis_window_background</item>
        <item name="colorError">@color/jarvis_gold</item>
    </style>

    <!-- App Title (no dot notation to avoid implicit parent) -->
    <style name="JARVIS_AppTitle">
        <item name="android:textColor">@color/jarvis_text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card Title -->
    <style name="JARVIS_CardTitle">
        <item name="android:textColor">@color/jarvis_text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Headline -->
    <style name="JARVIS_Headline">
        <item name="android:textColor">@color/jarvis_text_primary</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <!-- Caption -->
    <style name="JARVIS_Caption">
        <item name="android:textColor">@color/jarvis_text_secondary</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
</resources>
