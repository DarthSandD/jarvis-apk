<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/chat_spacing">

    <!-- User message (right-aligned) -->
    <LinearLayout
        android:id="@+id/container_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="@dimen/spacing_2xl">

            <TextView
                android:id="@+id/txt_user_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_user"
                android:paddingHorizontal="@dimen/chat_padding_horizontal"
                android:paddingVertical="@dimen/chat_padding_vertical"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="@dimen/text_chat"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:maxWidth="@dimen/chat_bubble_max"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/txt_user_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:textColor="@color/jarvis_chat_time"
                android:textSize="@dimen/text_chat_time"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- Assistant message (left-aligned) -->
    <LinearLayout
        android:id="@+id/container_assistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:visibility="gone">

        <View
            android:id="@+id/avatar_assistant"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_voice_active"
            android:backgroundTint="@color/jarvis_avatar_assistant" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:layout_marginEnd="@dimen/spacing_2xl">

            <TextView
                android:id="@+id/txt_assistant_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_assistant"
                android:paddingHorizontal="@dimen/chat_padding_horizontal"
                android:paddingVertical="@dimen/chat_padding_vertical"
                android:textColor="@color/jarvis_text_primary"
                android:textSize="@dimen/text_chat"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:maxWidth="@dimen/chat_bubble_max"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/txt_assistant_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_marginStart="@dimen/spacing_sm"
                android:textColor="@color/jarvis_chat_time"
                android:textSize="@dimen/text_chat_time"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- System message (centered) -->
    <TextView
        android:id="@+id/txt_system_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="@dimen/spacing_sm"
        android:background="@drawable/bg_chat_assistant"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        android:textColor="@color/jarvis_text_secondary"
        android:textSize="@dimen/text_caption"
        android:fontFamily="sans-serif"
        android:textStyle="italic"
        android:visibility="gone" />

</LinearLayout>
