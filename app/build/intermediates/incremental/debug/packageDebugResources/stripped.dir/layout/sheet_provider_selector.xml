<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/jarvis_surface">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select AI Provider"
        android:textColor="@color/jarvis_text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_lg" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_providers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_select_openai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="OpenAI API"
            android:textColor="@color/jarvis_text_primary"
            app:chipIcon="@drawable/ic_cloud"
            app:chipIconTint="@color/jarvis_accent"
            app:chipBackgroundColor="@color/jarvis_chip_background"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_select_local"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="Local AI (llama.cpp)"
            android:textColor="@color/jarvis_text_primary"
            app:chipIcon="@drawable/ic_phone"
            app:chipIconTint="@color/jarvis_accent"
            app:chipBackgroundColor="@color/jarvis_chip_background"
            style="@style/Widget.Material3.Chip.Filter" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_select_hermes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hermes OmniRoute"
            android:textColor="@color/jarvis_text_primary"
            app:chipIcon="@drawable/ic_server"
            app:chipIconTint="@color/jarvis_accent"
            app:chipBackgroundColor="@color/jarvis_chip_background"
            style="@style/Widget.Material3.Chip.Filter" />

    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Changes take effect on the next message"
        android:textColor="@color/jarvis_text_secondary"
        android:textSize="@dimen/text_caption"
        android:layout_marginTop="@dimen/spacing_md" />

</LinearLayout>